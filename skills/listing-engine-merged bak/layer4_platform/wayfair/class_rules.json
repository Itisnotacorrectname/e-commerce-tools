      "requiredAttributes": ["weight_capacity","number_of_slats","headboard_height","assembly_required","box_spring_required"],
      "boxSpringRequired": false
    },
    {
      "classId": "TODO_CONFIRM",
      "className": "Bed Frames",
      "triggerKeywords": ["bed frame","metal frame","steel frame"],
      "excludeKeywords": ["headboard","upholstered","adjustable"],
      "requiredAttributes": ["weight_capacity","frame_height","assembly_required","box_spring_required","slat_kit_included"],
      "boxSpringRequired": "check listing"
    },
    {
      "classId": "TODO_CONFIRM",
      "className": "Dining Tables",
