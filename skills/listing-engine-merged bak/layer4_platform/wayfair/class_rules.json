      "excludeKeywords": ["coffee table","end table"],
      "requiredAttributes": ["table_top_material","base_material","shape","seating_capacity","assembly_required","weight_capacity"]
    }
  ],
  "fallback": {
    "className": "General Furniture",
    "requiredAttributes": ["material","assembly_required","weight_capacity"]
